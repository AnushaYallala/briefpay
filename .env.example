# ---------- backend ----------
APP_ENV=dev
APP_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
JWT_SECRET=change-me
DATABASE_URL=postgresql+psycopg://avnadmin:password@host:port/defaultdb?sslmode=require
DATABASE_SSL_CA=./aiven-ca.pem

PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

AI_PROVIDER=replay_or_real      # gemini | replay | replay_or_real
GEMINI_API_KEY=
AI_MODEL=                       # verify current Gemini Flash model name
# Optional: write the brief (BRD) with Groq instead of Gemini. Only that one step changes; every other AI step stays on Gemini.
# The meeting transcript and project details are sent to Groq for that step. Leave BRD_PROVIDER empty to keep everything on Gemini.
BRD_PROVIDER=                   # empty | groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b    # check this name is still offered on Groq's model list (the older llama-3.3-70b-versatile was withdrawn)
GITHUB_TOKEN=

IMAGE_PROVIDER=local           # cloudinary | local
CLOUDINARY_URL=                 # cloudinary://<api_key>:<api_secret>@<cloud_name>

FEE_RESERVE_PER_ITEM_CENTS=0
PAYOUT_MAX_CENTS=100000
PAYOUT_MAX_PER_HOUR=10
PLEDGE_MAX_HOURS=72
HONOR_SAFETY_MARGIN_HOURS=2
PLEDGE_MIN_CENTS=500
DEFAULT_CLOSE_POLICY=EARLY_ON_GOAL   # EARLY_ON_GOAL | AT_DEADLINE
CLOCK_INTERVAL_SECONDS=60
POLL_INTERVAL_SECONDS=30          # how often the API asks PayPal about steps whose webhook never arrived
LOCAL_IMAGES_DIR=./local_images   # IMAGE_PROVIDER=local only (dev)
IMAGE_MAX_BYTES=5000000
IMAGE_URL_TTL_SECONDS=300         # how long a signed image link works
BA_TARGET_SCORE=90
BA_MAX_ROUNDS=5
DEMO_MODE=true
CORS_ORIGINS=http://localhost:3000

# ---------- frontend (frontend/.env.local) ----------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
NEXT_PUBLIC_DEMO_MODE=true
