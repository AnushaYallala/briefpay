# ---------- backend ----------
APP_ENV=dev
APP_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
JWT_SECRET=change-me
DATABASE_URL=postgresql+psycopg://avnadmin:password@host:port/defaultdb?sslmode=require
DATABASE_SSL_CA=./aiven-ca.pem

PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

AI_PROVIDER=replay_or_real      # gemini | replay | replay_or_real
GEMINI_API_KEY=
AI_MODEL=                       # verify current Gemini Flash model name
GITHUB_TOKEN=

IMAGE_PROVIDER=local           # cloudinary | local
CLOUDINARY_URL=                 # cloudinary://<api_key>:<api_secret>@<cloud_name>

FEE_RESERVE_PER_ITEM_CENTS=0
PAYOUT_MAX_CENTS=100000
PAYOUT_MAX_PER_HOUR=10
PLEDGE_MAX_HOURS=72
HONOR_SAFETY_MARGIN_HOURS=2
PLEDGE_MIN_CENTS=500
DEFAULT_CLOSE_POLICY=EARLY_ON_GOAL   # EARLY_ON_GOAL | AT_DEADLINE
CLOCK_INTERVAL_SECONDS=60
BA_TARGET_SCORE=90
BA_MAX_ROUNDS=5
DEMO_MODE=true
CORS_ORIGINS=http://localhost:3000

# ---------- frontend (frontend/.env.local) ----------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
NEXT_PUBLIC_DEMO_MODE=true
